# Copy to .env — values are read by src/config.js
PORT=3000
# Public HTTPS URL of THIS addon (BitChord needs absolute stream URLs).
# For local testing: http://localhost:3000  |  For real use: https://your-host
PUBLIC_BASE_URL=http://localhost:3000

# --- Backend select: soulseek | terabox | mock (auto when unset) ---
#ADDON_BACKEND=soulseek

# --- TeraBox backend (via saahiyo/terabox-gateway; needs YOUR share URLs) ---
# The gateway holds your TeraBox ndus cookie; the addon only needs its URL.
#TERABOX_GATEWAY_URL=http://localhost:5000
# Local match index built by scripts/build-terabox-catalog.mjs
#TERABOX_CATALOG=./terabox.catalog.json
# Share URLs to index (or pass as script args)
#TERABOX_SHARES=https://teraboxshare.com/s/XXXX,https://terabox.com/s/YYYY

# --- SoulSeek backend (leave empty for mock/dev mode) ---
# slskd = headless SoulSeek daemon. No desktop app needed, but SOMETHING must
# stay logged into the SoulSeek network — there is no public/anonymous API.
SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=
# Shared folder slskd downloads into (same volume in docker-compose.yml)
DOWNLOAD_DIR=./downloads
# Partial downloads live here until complete (served progressively)
INCOMPLETE_DIR=./incomplete
# Stable share dir for the quarantine gate (empty = disabled)
#SHARED_DIR=./shared
# TeraBox cache mount (rclone mount, see deploy/terabox-setup.sh).
# Complete-by-construction -> served immutable. Empty = disabled.
#TERABOX_DIR=/terabox
# Kill-switch for the whole TeraBox tier (serve + archive + gate target).
#TERABOX_ENABLED=1
# Read-only library mount (e.g. another box's WebDAV via rclone mount).
# Served immutable, never written. Local match index built by
# scripts/build-hifi-index.mjs (HIFI_INDEX) makes it searchable.
#WEBDAV_DIR=/hifi
#WEBDAV_ENABLED=1
#HIFI_INDEX=./hifi.index.json
# Timing
SEARCH_TIMEOUT_MS=8000
STREAM_WAIT_MS=20000

# --- Addon identity ---
ADDON_ID=dev.soulseek.addon
# --- Access control (optional) ---
# Shared token: when set, EVERY addon route (manifest included) lives under
# /<token>/... — bare paths 401. Token must be URL-safe (hex recommended).
# Advertised as the manifest's token default (BitChord forwards it). Stops
# scanners and drive-by use; anyone holding a full prefixed URL holds the key.
# True revocation = rotate this (old URLs die instantly: the path changes).
#ADDON_TOKEN=change-me-to-something-long
ADDON_NAME=SoulSeek (via slskd)
ADDON_VERSION=0.1.0
